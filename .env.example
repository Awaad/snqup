# Every name here must exist; a missing secret fails loudly at startup rather
# than silently falling back to something that happens to work in dev.

ENVIRONMENT=local
VERSION=dev
LOG_LEVEL=DEBUG

# Two connection strings on purpose. LISTEN needs a connection OUTSIDE the
# pooler - Supavisor in transaction mode silently breaks the SSE listener
# and the organizer dashboard freezes with no error (ADR-0006).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/acme
DATABASE_LISTEN_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/acme

REDIS_URL=redis://localhost:6379/0

# Supabase Auth is an identity provider only. It holds credentials and issues
# JWTs; it never sees a card, a connection or an event (ADR-0005).
JWT_ISSUER=https://your-project.supabase.co/auth/v1
JWT_AUDIENCE=authenticated
JWT_PUBLIC_KEYS=

SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Three domains, deliberately separate. A Safe Browsing hit on the UGC domain
# must not take down the API, the app or the marketing site (ADR-0008).
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PUBLIC_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:8000

RESEND_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
APPLE_SHARED_SECRET=
