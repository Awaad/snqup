.expo/
*.jks
*.p8
*.p12
*.mobileprovision
ios/
android/

# Editor
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store

# Logs
*.log
npm-debug.log*
