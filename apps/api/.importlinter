# Enforces ADR-0025. Convention alone does not hold this line; without a tool
# the domains become notional within a month.

[importlinter]
root_package = acme
include_external_packages = True

# NOTE: exchange has no repository or models. It owns no tables and
# orchestrates other domains' services instead, so there is nothing to forbid.
[importlinter:contract:1]
name = Domains may not import each other's internals
type = forbidden
source_modules =
    acme.domains.identity
    acme.domains.cards
    acme.domains.exchange
    acme.domains.connections
    acme.domains.events
    acme.domains.billing
    acme.domains.safety
forbidden_modules =
    acme.domains.identity.repository
    acme.domains.cards.repository
    acme.domains.connections.repository
    acme.domains.events.repository
    acme.domains.billing.repository
    acme.domains.safety.repository
    acme.domains.identity.models
    acme.domains.cards.models
    acme.domains.connections.models
    acme.domains.events.models
    acme.domains.billing.models
    acme.domains.safety.models
# TRUE, deliberately. The rule is "do not import another domain's internals
# DIRECTLY". A domain's own service necessarily uses its own repository, so
# forbidding the indirect path makes the service interface - the one thing
# domains ARE allowed to import - unusable:
#
#   cards.service -> identity.service -> identity.repository
#
# would be reported as a violation, leaving no legal way to call across
# domains at all.
allow_indirect_imports = True

[importlinter:contract:2]
name = Core is independent of every domain
type = forbidden
source_modules =
    acme.core
forbidden_modules =
    acme.domains

# acme.workers sits at the same level as acme.api: both are entry points that
# orchestrate domains. It was omitted at first and therefore unconstrained,
# which let job code import domain models directly - the same mistake the
# routers made, caught the same way once the layer was declared.
[importlinter:contract:3]
name = Layers
type = layers
layers =
    acme.api | acme.workers
    acme.domains
    acme.core

# Entry points talk to SERVICES, not to internals.
#
# The layers contract alone is not enough: it stops a domain importing api, but
# it happily allows api or workers to reach into a domain's repository or
# models. That makes "domains may not import each other's internals"
# half-enforced - the domains behave, and the entry points do whatever they
# like, which is where the coupling actually accumulates.
#
# Schemas ARE importable: they are the domain's declared shape, and a router
# has to name the type it returns.
[importlinter:contract:4]
name = Entry points may not import domain internals
type = forbidden
source_modules =
    acme.api
    acme.workers
forbidden_modules =
    acme.domains.identity.repository
    acme.domains.cards.repository
    acme.domains.connections.repository
    acme.domains.events.repository
    acme.domains.billing.repository
    acme.domains.safety.repository
    acme.domains.identity.models
    acme.domains.cards.models
    acme.domains.connections.models
    acme.domains.events.models
    acme.domains.billing.models
    acme.domains.safety.models
    acme.domains.notifications.models
allow_indirect_imports = True
