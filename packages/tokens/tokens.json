{
  "$description": "Single source of truth (ADR-0017). Semantic names only: surface.raised, never blue-500. Slower when you just want 'that blue', and it is the discipline that makes dark mode mechanical rather than a rewrite. NOT card themes - those are user data, versioned, stored per card (ADR-0004).",
  "color": {
    "brand": {
      "50":  { "value": "#eef4ff" },
      "500": { "value": "#3b5bdb" },
      "600": { "value": "#2f4bc4" },
      "900": { "value": "#1a2a6b" }
    },
    "neutral": {
      "0":   { "value": "#ffffff" },
      "50":  { "value": "#f8f9fa" },
      "100": { "value": "#f1f3f5" },
      "300": { "value": "#dee2e6" },
      "500": { "value": "#adb5bd" },
      "700": { "value": "#495057" },
      "900": { "value": "#212529" },
      "1000":{ "value": "#0b0c0d" }
    },
    "status": {
      "success": { "value": "#2b8a3e" },
      "warning": { "value": "#e8590c" },
      "danger":  { "value": "#c92a2a" }
    },
    "semantic": {
      "$description": "What components reference. Resolves per theme.",
      "light": {
        "surface":        { "value": "{color.neutral.0.value}" },
        "surface-raised": { "value": "{color.neutral.50.value}" },
        "surface-sunken": { "value": "{color.neutral.100.value}" },
        "border":         { "value": "{color.neutral.300.value}" },
        "text":           { "value": "{color.neutral.900.value}" },
        "text-muted":     { "value": "{color.neutral.700.value}" },
        "accent":         { "value": "{color.brand.500.value}" }
      },
      "dark": {
        "surface":        { "value": "{color.neutral.1000.value}" },
        "surface-raised": { "value": "{color.neutral.900.value}" },
        "surface-sunken": { "value": "{color.neutral.1000.value}" },
        "border":         { "value": "{color.neutral.700.value}" },
        "text":           { "value": "{color.neutral.50.value}" },
        "text-muted":     { "value": "{color.neutral.500.value}" },
        "accent":         { "value": "{color.brand.500.value}" }
      }
    }
  },
  "space": {
